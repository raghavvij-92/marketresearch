# ============================================================
# India Stock Researcher — configuration
# Copy to .env for local runs, or set these as GitHub Actions
# repository secrets for automated daily runs.
# ============================================================

# ---------------- Watchlist (required) ----------------------
# NSE symbols by default; use .BO or a 6-digit scrip code for BSE.
# Indices allowed too: NIFTY, BANKNIFTY, SENSEX
STOCK_LIST=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK

# ---------------- LLM (configure at least one) --------------
# First provider with a key wins; pin explicitly with LLM_PROVIDER
# (gemini | openai | anthropic).
#LLM_PROVIDER=gemini

#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.0-flash

# Works with any OpenAI-compatible endpoint (OpenAI, DeepSeek, Groq, Ollama...)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5

#LLM_TEMPERATURE=0.3
#LLM_MAX_TOKENS=8192
#LLM_TIMEOUT=180
#LLM_MAX_RETRIES=3

# ---------------- Data ---------------------------------------
#HISTORY_DAYS=400
# Direct nseindia.com enrichment (delivery %, FII/DII, announcements).
# Best-effort; disable if your network/CI cannot reach NSE.
#ENABLE_NSE_DIRECT=true
#REQUEST_TIMEOUT=20

# ---------------- News ---------------------------------------
#ENABLE_NEWS=true
#NEWS_PER_STOCK=8
#NEWS_WINDOW_DAYS=7
# Optional paid search APIs (free Google News RSS is used otherwise)
#TAVILY_API_KEY=
#SERPAPI_API_KEY=

# ---------------- Notifications (optional) -------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

#DISCORD_WEBHOOK_URL=

#SLACK_WEBHOOK_URL=

# Gmail requires an App Password (Google Account → Security → App passwords)
#EMAIL_SENDER=
#EMAIL_PASSWORD=
#EMAIL_RECEIVERS=you@example.com,friend@example.com
# SMTP autodetected for common providers; override if needed:
#EMAIL_SMTP_SERVER=
#EMAIL_SMTP_PORT=465

# ---------------- Output --------------------------------------
#OUTPUT_DIR=reports
#DATABASE_PATH=data/analysis_history.db
#LOG_LEVEL=INFO
